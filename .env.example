# Environment contract — The Nagarik

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=The Nagarik
NEXT_PUBLIC_SITE_NAME_NE=द नागरिक
NEXT_PUBLIC_DEFAULT_LOCALE=ne

# Content: facade | payload (facade uses DEV_ONLY fixtures when not payload)
CONTENT_SOURCE=facade

# Database (required when CONTENT_SOURCE=payload)
DATABASE_URL=
PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Media
BLOB_READ_WRITE_TOKEN=

# Ops
REVALIDATE_SECRET=change-me-revalidate-secret-32chars-min
CRON_SECRET=change-me-cron-secret-at-least-32-characters
CRON_BASE_URL=

# Algorithms
ALGORITHMS_ENABLED=true
BREAKING_AUTO_BOOST=false

# Observability (leave empty = do not claim Sentry)
SENTRY_DSN=

# Launch
LAUNCH_STATUS=dev
ALLOW_DEV_FIXTURES=true
