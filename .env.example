# Environment contract — The Nagarik

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=The Nagarik
NEXT_PUBLIC_SITE_NAME_NE=द नागरिक
NEXT_PUBLIC_DEFAULT_LOCALE=ne
# Optional: calendar/patro product origin (e.g. https://calendar.example.com). Empty = in-app /{locale}/utilities/nepali-patro
NEXT_PUBLIC_CALENDAR_URL=

# Content: facade | payload (facade uses DEV_ONLY fixtures when not payload)
CONTENT_SOURCE=facade

# Database (required when CONTENT_SOURCE=payload or opening /cms)
# Neon pooled URL, or:
#   Docker: postgresql://nagarik:nagarik_dev_password@127.0.0.1:5432/nagarik
#   Embedded: pnpm --filter @thenagarik/web local:pg  (writes this file + apps/web/.env.local)
# See docs/LOCAL_DB.md
DATABASE_URL=
PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Dev schema push; set false in production and run migrations
PAYLOAD_DB_PUSH=true

# Media (Vercel Blob; without token, Payload uses local upload dir in dev)
BLOB_READ_WRITE_TOKEN=

# Optional: enable live gold/forex fetchers when implemented (default off — fixtures labeled sample)
LIVE_MARKET_RATES=false

# Ops
REVALIDATE_SECRET=change-me-revalidate-secret-32chars-min
CRON_SECRET=change-me-cron-secret-at-least-32-characters
CRON_BASE_URL=

# Algorithms
ALGORITHMS_ENABLED=true
BREAKING_AUTO_BOOST=false

# Observability (leave empty = do not claim Sentry)
SENTRY_DSN=

# Launch
LAUNCH_STATUS=dev
ALLOW_DEV_FIXTURES=true
