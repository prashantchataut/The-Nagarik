{
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @thenagarik/web build",
  "crons": [
    {
      "path": "/api/cron/ops-probe",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/scheduled-publish",
      "schedule": "*/15 * * * *"
    }
  ]
}
